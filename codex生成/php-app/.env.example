APP_ENV=local
APP_KEY=replace-with-a-long-random-secret
DEMO_BOOTSTRAP_PASSWORD=Demo12345
ADMIN_BOOTSTRAP_PASSWORD=Admin12345

# Optional OpenAI-compatible Chat Completions API for AI workout planning.
# Keep AI_API_KEY out of Git and configure it in Render Environment.
AI_API_KEY=
AI_MODEL=
AI_API_URL=https://api.openai.com/v1/chat/completions

# Local preview. Leave DATABASE_URL empty to use SQLite.
SQLITE_PATH=storage/app.sqlite

# Production PostgreSQL examples:
# DATABASE_URL=postgresql://fittrack_user:password@localhost:5432/fittrack
# DATABASE_URL=pgsql:host=127.0.0.1;port=5432;dbname=fittrack
# DB_USER=fittrack_user
# DB_PASSWORD=change-me
