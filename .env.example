# Backend-only value. Never expose this to Vite/browser code.
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/fitness_tracker
SECRET_KEY=change_me_to_a_long_random_secret

# Optional admin bootstrap. Set this only in local .env or cloud environment variables.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change_me_admin_password

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional ExerciseDB sync. The app has local fallback data if this API is unavailable.
EXERCISEDB_API_URL=https://oss.exercisedb.dev/api/v1/exercises
EXERCISEDB_SYNC_ON_SEED=false

# Optional LLM planning. Keep this backend-only; never expose it as VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_FORCE_FAILURE=false
LLM_TIMEOUT_SECONDS=25

# Frontend API base URL. VITE_ variables are public browser configuration.
VITE_API_URL=http://localhost:8000/api
