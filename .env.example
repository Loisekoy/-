# Backend-only value. Never expose this to Vite/browser code.
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/fitness_tracker

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Frontend API base URL. VITE_ variables are public browser configuration.
VITE_API_URL=http://localhost:8000/api
