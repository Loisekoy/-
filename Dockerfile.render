FROM php:8.4-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends libcurl4-openssl-dev libpq-dev \
    && docker-php-ext-install curl pdo_pgsql pcntl \
    && a2enmod rewrite \
    && rm -rf /var/lib/apt/lists/*

ENV APACHE_DOCUMENT_ROOT=/var/www/html/public

COPY ["web/php-app/docker/apache-fittrack.conf", "/etc/apache2/conf-available/fittrack.conf"]

RUN a2enconf fittrack \
    && sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
        /etc/apache2/sites-available/*.conf \
        /etc/apache2/apache2.conf \
        /etc/apache2/conf-available/*.conf \
    && sed -ri '/<Directory \/var\/www\/>/,/<\/Directory>/ s/AllowOverride None/AllowOverride All/' \
        /etc/apache2/apache2.conf

WORKDIR /var/www/html

COPY ["web/php-app/", "/var/www/html/"]

RUN mkdir -p storage public/media/exercises \
    && chown -R www-data:www-data storage public/media/exercises

EXPOSE 80

CMD ["sh", "-c", "php bin/migrate.php && php bin/setup.php && apache2-foreground"]
